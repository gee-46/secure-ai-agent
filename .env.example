# Copy this file to .env and adjust as needed. No secrets are required
# because this application is local-first and does not call external APIs.

# SQLite database file location
APP_DB_PATH=data/app.db

# Directory where encrypted file containers are stored
STORAGE_DIR=storage

# Directory where RSA private key files (passphrase-protected) are stored
KEYS_DIR=storage/keys

# Trained classifier model location
MODEL_PATH=models/sensitivity_classifier.joblib

# Maximum upload size in megabytes
MAX_UPLOAD_MB=25

# Maximum failed login/decryption attempts before temporary lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_SECONDS=60
